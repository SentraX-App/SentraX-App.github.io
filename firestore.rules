rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================================
    // Sentra Care (paid doctor chat) - ADDED. Nothing above or below that
    // existed before this block was changed, except one extra "allow read"
    // line inside /users for doctors (marked NEW).
    // ====================================================================
    function signedIn() { return request.auth != null; }
    function isDoctor() { return signedIn() && exists(/databases/$(database)/documents/doctors/$(request.auth.uid)); }
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // A plan is active when its entitlement says so and has not expired.
    function entActive(ownerUid) {
      return exists(/databases/$(database)/documents/entitlements/$(ownerUid))
          && get(/databases/$(database)/documents/entitlements/$(ownerUid)).data.status == 'active'
          && get(/databases/$(database)/documents/entitlements/$(ownerUid)).data.expiresAt > request.time.toMillis();
    }
    // This person is covered by their own plan, or by a Duo/Family plan that lists them.
    function hasPlan(uid) {
      return entActive(uid)
          || (exists(/databases/$(database)/documents/memberOf/$(uid))
              && entActive(get(/databases/$(database)/documents/memberOf/$(uid)).data.ownerUid)
              && uid in get(/databases/$(database)/documents/entitlements/$(get(/databases/$(database)/documents/memberOf/$(uid)).data.ownerUid)).data.memberUids);
    }

    match /users/{userId} {
      // Unchanged - owner keeps full read/write, exactly as before.
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;

      // NEW: a linked caregiver can read (never write) this patient's data.
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.get('caregiverUids', []);

      // NEW: a Sentra-X doctor can read (never write) the record of a patient who is on an active plan
      // AND has switched on "Share my readings with the doctor" in the doctor chat.
      allow read: if isDoctor()
                  && exists(/databases/$(database)/documents/consults/$(userId))
                  && get(/databases/$(database)/documents/consults/$(userId)).data.get('shareVitals', false) == true
                  && hasPlan(userId);

      // NEW: a caregiver may add themselves to caregiverUids ONLY if their
      // own caregiverLinks doc proves they claimed a valid invite for this
      // exact patient. Nothing else on this document can be touched by them.
      allow update: if request.auth != null
                    && request.auth.uid != userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caregiverUids', 'caregiverInfo'])
                    && request.auth.uid in request.resource.data.caregiverUids
                    && !(request.auth.uid in resource.data.get('caregiverUids', []))
                    && request.resource.data.caregiverUids.size() == resource.data.get('caregiverUids', []).size() + 1
                    && resource.data.get('caregiverUids', []).size() < 8
                    && request.resource.data.caregiverInfo.diff(resource.data.get('caregiverInfo', {})).affectedKeys().hasOnly([request.auth.uid])
                    && (
                      (exists(/databases/$(database)/documents/caregiverLinks/$(request.auth.uid))
                        && get(/databases/$(database)/documents/caregiverLinks/$(request.auth.uid)).data.patientUid == userId)
                      || exists(/databases/$(database)/documents/caregiverLinks/$(request.auth.uid + '_' + userId))
                    );
      // A caregiver may take THEMSELVES off the access list (opting out),
      // and nothing else on the document: exactly one entry removed, and it
      // must be their own.
      allow update: if request.auth != null
                    && request.auth.uid != userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caregiverUids', 'caregiverInfo'])
                    && request.auth.uid in resource.data.get('caregiverUids', [])
                    && !(request.auth.uid in request.resource.data.get('caregiverUids', []))
                    && request.resource.data.get('caregiverUids', []).size() == resource.data.get('caregiverUids', []).size() - 1
                    && request.resource.data.get('caregiverInfo', {}).diff(resource.data.get('caregiverInfo', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /invites/{code} {
      // Patient can only create an invite naming themselves as the patient.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.patientUid;

      // A signed-in user can read ONE invite if they already know its code
      // (needed to check validity before claiming). Listing/querying the
      // collection is NOT allowed for strangers: it used to be, which let any
      // account list every open invite and claim one. The patient can list
      // only their own invites (used when deleting an account).
      allow get: if request.auth != null;
      allow list: if request.auth != null
                  && resource.data.patientUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.patientUid == request.auth.uid;

      // Claiming: can only move usedBy from empty to your own uid - nothing
      // else on the invite can be changed, and it can't be re-claimed.
      // Expiry is now enforced here too, not only in the app.
      allow update: if request.auth != null
                    && resource.data.usedBy == null
                    && request.time.toMillis() < resource.data.get('expiresAt', 0)
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy']);
    }

    match /medPhotos/{photoId} {
      // Doc ID convention (patientUid_medId_date) is for readability/
      // uniqueness only — the actual permission check below is always on
      // the patientUid FIELD inside the document, never parsed from the ID.
      allow create: if request.auth != null
                    && request.resource.data.patientUid == request.auth.uid
                    && request.resource.data.medId is string
                    && request.resource.data.photoBase64 is string;

      // Owner, or a caregiver this patient's own users/{uid} doc already
      // lists in caregiverUids — the same access gate the main patient
      // record itself uses, so a photo is never readable by anyone who
      // couldn't already read the rest of this patient's data.
      allow read: if request.auth != null
                  && (resource.data.patientUid == request.auth.uid
                      || request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.patientUid)).data.get('caregiverUids', []));

      // The patient can delete their own photos (account/data deletion).
      allow delete: if request.auth != null
                    && resource.data.patientUid == request.auth.uid;
    }

    match /caregiverLinks/{linkId} {
      // Two link formats coexist on purpose. OLD links use the caregiver's
      // own uid as the doc ID (linkId == uid, no caregiverUid field). NEW
      // links use an auto-generated ID plus an explicit caregiverUid field,
      // which is what lets one caregiver hold links to several patients.
      // Reads are checked per document, so a query for your own links only
      // ever returns docs that pass this check.
      allow read: if request.auth != null
                  && (linkId == request.auth.uid
                      || resource.data.caregiverUid == request.auth.uid
                      || resource.data.get('patientUid', '') == request.auth.uid);

      // Can only create a link that names YOU as the caregiver, and only if
      // it points at the patient whose invite you just successfully claimed.
      allow create: if request.auth != null
                    && request.resource.data.caregiverUid == request.auth.uid
                    && linkId == request.auth.uid + '_' + request.resource.data.patientUid
                    && request.resource.data.patientUid is string
                    && request.resource.data.claimCode is string
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimCode)).data.usedBy == request.auth.uid
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.claimCode)).data.patientUid == request.resource.data.patientUid;

      // A caregiver may remove their own links, opting themselves out.
      // A patient may remove links that point at THEM, which is only used
      // when they delete their account (access is already controlled by the
      // caregiverUids list on their own record).
      allow delete: if request.auth != null
                    && (linkId == request.auth.uid
                        || resource.data.caregiverUid == request.auth.uid
                        || resource.data.get('patientUid', '') == request.auth.uid);
    }

    // ---- Plans. Clients can read their own plan but can NEVER write one: only an admin account can. ----
    match /entitlements/{ownerUid} {
      allow read: if signedIn()
                  && (request.auth.uid == ownerUid
                      || request.auth.uid in resource.data.get('memberUids', [])
                      || isAdmin());
      allow create, update: if isAdmin();
      // The person who paid may add or remove the people on their own Duo/Family plan, and nothing else on it.
      allow update: if signedIn()
                    && request.auth.uid == ownerUid
                    && resource.data.status == 'active'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames'])
                    && request.resource.data.memberUids.size() <= resource.data.get('seats', 1)
                    && ownerUid in request.resource.data.memberUids;
      allow delete: if false;
    }

    // Points a member at the plan they share. Only the plan owner can create it, and only for someone already on their plan.
    match /memberOf/{memberUid} {
      allow read: if signedIn()
                  && (request.auth.uid == memberUid
                      || resource.data.get('ownerUid', '') == request.auth.uid
                      || isAdmin());
      allow create, update: if signedIn()
                            && request.resource.data.ownerUid == request.auth.uid
                            && memberUid in getAfter(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.memberUids;
      allow delete: if signedIn()
                    && (resource.data.get('ownerUid', '') == request.auth.uid || request.auth.uid == memberUid);
    }

    // A payment the person says they made. Only an admin can approve or reject it.
    match /paymentClaims/{claimId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.plan in ['normal', 'duo', 'family']
                    && request.resource.data.reference is string
                    && claimId == request.resource.data.reference
                    && request.resource.data.amount is number;
      allow read: if signedIn() && (resource.data.get('uid', '') == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // SMS allowance counter. Written only by the alert server (Admin SDK, which bypasses rules); a person can only read their own, to see what is left.
    match /smsUsage/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Launch-offer counter (for example promos/duo: limit 5, claimed N). Everyone signed in can read it; only an admin can change it.
    match /promos/{promoId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Role markers. Created by hand in the Firebase console only; the app can only check its own.
    match /doctors/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Doctor chat. One private thread per person; messages are never edited or deleted from the app. ----
    match /consults/{patientUid} {
      allow read: if signedIn() && (request.auth.uid == patientUid || isDoctor());
      allow create: if signedIn()
                    && request.auth.uid == patientUid
                    && hasPlan(patientUid)
                    && request.resource.data.patientUid == patientUid;
      // The patient can update their own thread while on a plan.
      allow update: if signedIn()
                    && request.auth.uid == patientUid
                    && hasPlan(patientUid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientName', 'plan', 'lastMessage', 'lastAt', 'unreadDoctor', 'unreadPatient', 'shareVitals', 'sharedAt', 'consentAt']);
      // Clearing their own "new message" dot is always allowed, even after a plan ends.
      allow update: if signedIn()
                    && request.auth.uid == patientUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadPatient']);
      allow update: if isDoctor()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'unreadDoctor', 'unreadPatient', 'doctorName']);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn() && (request.auth.uid == patientUid || isDoctor());
        allow create: if signedIn()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.at is number
                      && ((request.auth.uid == patientUid
                           && request.resource.data.from == 'patient'
                           && request.resource.data.senderUid == request.auth.uid
                           && hasPlan(patientUid))
                          || (isDoctor()
                              && request.resource.data.from == 'doctor'
                              && request.resource.data.senderUid == request.auth.uid));
        allow update, delete: if false;
      }
    }
  }
}
